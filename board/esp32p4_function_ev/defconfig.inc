# ESP32-P4-Function-EV-Board 功能增量（叠加在 nsh defconfig 之上）
# 用法：cat configs/nsh/defconfig defconfig.inc | sort -u > 新 defconfig
# 各开关随阶段 1~4 逐步启用。

# --- 阶段 1：显示链路（MIPI-DSI + EK79007 + GT911 + LVGL）---
#CONFIG_ESPRESSIF_MIPI_DSI=y
#CONFIG_ESPRESSIF_MIPI_DSI_LANES=2
#CONFIG_ESPRESSIF_MIPI_DSI_LANE_BITRATE_MBPS=1000
#CONFIG_FB=y
#CONFIG_ESP32P4_FUNCTION_EV_LCD=y
#CONFIG_ESP32P4_FUNCTION_EV_TOUCH=y
#CONFIG_INPUT_GT9XX=y
#CONFIG_ESPRESSIF_I2C0=y
#CONFIG_ESPRESSIF_I2C0_SCLPIN=7
#CONFIG_ESPRESSIF_I2C0_SDAPIN=8
#CONFIG_GRAPHICS_LVGL=y
#CONFIG_LV_USE_NUTTX_FBDEV=y
#CONFIG_LV_USE_NUTTX_TOUCHSCREEN=y
#CONFIG_LV_COLOR_DEPTH=16

# --- 阶段 2：摄像头链路（MIPI-CSI + ISP）---
#CONFIG_ESPRESSIF_MIPI_CSI=y
#CONFIG_VIDEO=y

# --- 阶段 3：推理链路（TFLite Micro）---
#CONFIG_TENSORFLOW_LITE_MICRO=y

