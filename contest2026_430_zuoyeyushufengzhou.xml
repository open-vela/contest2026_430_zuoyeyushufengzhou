<?xml version='1.0' encoding='UTF-8'?>
<manifest>
  <!--
    Team repo manifest. Includes the full openvela base project set
    (openvela.xml in this same repo) and adds this team repo as a self-ref
    project, exposing its work-form subdirectories to openvela working-tree
    locations via <linkfile>. remote/default come from the included openvela.xml.
  -->
  <include name="openvela.xml"/>

  <project path="contest2026_430_zuoyeyushufengzhou" name="contest2026_430_zuoyeyushufengzhou">
    <!-- SignBridge app -> packages/demos (auto-picked by demos Make.defs wildcard) -->
    <linkfile src="app/signbridge" dest="packages/demos/contest2026_430_signbridge"/>
    <!-- ESP32-P4-Function-EV-Board adaptation docs & defconfig increments -->
    <linkfile src="board/esp32p4_function_ev" dest="vendor/openvela/boards/contest2026_430_esp32p4_function_ev"/>
  </project>
</manifest>
