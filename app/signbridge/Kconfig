config DEMOS_SIGNBRIDGE
	tristate "SignBridge on-device sign language recognition demo"
	default n
	---help---
		On-device sign language recognition terminal for the
		ESP32-P4-Function-EV-Board: MIPI camera capture, TFLite
		Micro hand landmark + temporal classification inference,
		and LVGL result display.

if DEMOS_SIGNBRIDGE

config DEMOS_SIGNBRIDGE_PROGNAME
	string "Program name"
	default "signbridge"
	---help---
		This is the name of the program that will be used when the NSH
		"Program Launcher" starts the application.

config DEMOS_SIGNBRIDGE_PRIORITY
	int "Task priority"
	default 100
	---help---
		This is the priority of the signbridge task.

config DEMOS_SIGNBRIDGE_STACKSIZE
	int "Stack size"
	default 8192
	---help---
		This is the stack size of the signbridge task.

config DEMOS_SIGNBRIDGE_VOCAB_SIZE
	int "Sign vocabulary size"
	default 50
	range 10 100
	---help---
		Number of sign language classes the temporal classifier
		outputs.

endif # DEMOS_SIGNBRIDGE
